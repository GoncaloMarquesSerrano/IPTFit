<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- ScrollView para o conteúdo rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="60dp"> <!-- Adicionado padding para a seta não cobrir conteúdo -->

            <!-- Card da imagem e info básica -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <!-- Imagem do Produto com fundo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivProductImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_foreground"
                            android:background="@color/background_light"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nome do Produto -->
                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/product_name_text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/primary_dark"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <!-- Marca -->
                    <TextView
                        android:id="@+id/tvBrands"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_text"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>

                    <!-- Código de Barras -->
                    <TextView
                        android:id="@+id/tvBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_code"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:background="@color/background_light"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:letterSpacing="0.1"/>

                    <!-- Nutri-Score com destaque -->
                    <LinearLayout
                        android:id="@+id/layoutNutriScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="@color/background_light"
                        app:cornerRadius="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nutri_score_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>

                        <TextView
                            android:id="@+id/tvNutriScore"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="@string/default_grade"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:background="@drawable/nutriscore_background"
                            android:gravity="center"
                            android:layout_marginStart="12dp"
                            app:cornerRadius="24dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card Informação Nutricional com gradiente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNutrition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@+id/_guideline"
                android:layout_marginTop="16dp"
                app:strokeColor="@color/secondary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nutrictional_info_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@android:drawable/ic_menu_agenda"
                        android:drawableTint="@color/secondary"/>

                    <!-- Energia -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/energy_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvEnergy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_calorie_quantity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                    <!-- Proteínas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/protein_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvProteins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_protein_quantity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                    <!-- Hidratos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/carbs_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvCarbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_carb_quantity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                    <!-- Gorduras -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/fats_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvFats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 g"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                    <!-- Fibra -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/fibers_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvFiber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_fiber_quantity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                    <!-- Sal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/salt_text"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/tvSalt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_salt_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_dark"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Campo de Notas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/cardNutrition"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/notes_text"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/secondary"
                    style="@style/Widget.IPTFit.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:gravity="top"
                        android:minHeight="100dp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Espaço reservado para o botão fixo (evita que conteúdo fique escondido) -->
            <View
                android:id="@+id/spacerForButton"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_constraintTop_toBottomOf="@id/cardNotes"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Guideline para posicionamento -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.5"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Seta de voltar no canto superior esquerdo -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top|start"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:backgroundTint="@color/primary_dark"
        app:tint="@color/icon_white"
        app:elevation="6dp"
        app:rippleColor="@color/accent"
        android:contentDescription="@string/back_button" />

    <!-- Botão Guardar FIXO no fundo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveConsumption"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/save_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_primary"
        android:padding="16dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconSize="24dp"
        app:iconTint="@color/icon_white"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:cornerRadius="12dp"
        android:layout_margin="16dp"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/accent"
        android:elevation="8dp" />

</FrameLayout>