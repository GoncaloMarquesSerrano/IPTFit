<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atividade"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Gráfico Semanal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esta Semana"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Gráfico -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Segunda -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="120"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_mon"
                            android:layout_width="24dp"
                            android:layout_height="60dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Terça -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="180"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_tue"
                            android:layout_width="24dp"
                            android:layout_height="90dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Quarta -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_wed"
                            android:layout_width="24dp"
                            android:layout_height="45dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Q"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Quinta -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="210"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_thu"
                            android:layout_width="24dp"
                            android:layout_height="105dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Q"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Sexta -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_fri"
                            android:layout_width="24dp"
                            android:layout_height="75dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Sábado -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="240"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_sat"
                            android:layout_width="24dp"
                            android:layout_height="120dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Domingo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/value_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="300"
                            android:textSize="10sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:id="@+id/bar_sun"
                            android:layout_width="24dp"
                            android:layout_height="150dp"
                            android:background="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/label_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="D"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Histórico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Card de histórico vazio -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum treino realizado"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comece agora!"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>