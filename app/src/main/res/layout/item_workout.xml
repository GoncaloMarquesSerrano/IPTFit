<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Conteúdo principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@+id/layout_actions"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/text_workout_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Treino"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_workout_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 min • 300 cal"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Ações -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">

            <!-- Botão Iniciar -->
            <Button
                android:id="@+id/button_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white" />

            <!-- Layout para quando está completado -->
            <LinearLayout
                android:id="@+id/layout_completed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Botão Refazer -->
                <Button
                    android:id="@+id/button_redo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refazer"
                    android:textSize="14sp"
                    android:backgroundTint="@color/gray_200"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="8dp" />

                <!-- Ícone de completado -->
                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_green"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>